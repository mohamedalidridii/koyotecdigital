{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/services",
      "destination": "/en/services.html"
    },
    {
      "source": "/en/contact",
      "destination": "/en/contact.html"
    },
    {
      "source": "/art-de-la-difference",
      "destination": "/art-de-la-difference.html"
    },
    {
      "source": "/en/art-of-difference",
      "destination": "/en/art-of-difference.html"
    },
    {
      "source": "/work",
      "destination": "/work.html"
    },
    {
      "source": "/directors",
      "destination": "/directors.html"
    },
    {
      "source": "/film",
      "destination": "/film.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/en/blog",
      "destination": "/en/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/en/blog/:slug.html"
    }
  ],
  "redirects": [
    {
      "source": "/culture",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/film",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/directors",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/engineering",
      "destination": "/engineering/",
      "permanent": true
    },
    {
      "source": "/engineering/:path(en|expertise|work|studio|engagements|contact|en/expertise|en/work|en/studio|en/engagements|en/contact)",
      "destination": "/engineering/:path/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(mp4|jpg|png|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
