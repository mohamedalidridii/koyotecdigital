{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/en/services",
      "destination": "/en/services.html"
    },
    {
      "source": "/en/contact",
      "destination": "/en/contact.html"
    },
    {
      "source": "/creation-site-web-tunis",
      "destination": "/creation-site-web-tunis.html"
    },
    {
      "source": "/en/web-design-tunisia",
      "destination": "/en/web-design-tunisia.html"
    },
    {
      "source": "/creation-logo-identite-visuelle",
      "destination": "/creation-logo-identite-visuelle.html"
    },
    {
      "source": "/referencement-seo-tunis",
      "destination": "/referencement-seo-tunis.html"
    },
    {
      "source": "/creation-site-e-commerce-tunisie",
      "destination": "/creation-site-e-commerce-tunisie.html"
    },
    {
      "source": "/en/logo-brand-identity-design",
      "destination": "/en/logo-brand-identity-design.html"
    },
    {
      "source": "/en/seo-agency-tunisia",
      "destination": "/en/seo-agency-tunisia.html"
    },
    {
      "source": "/en/ecommerce-website-tunisia",
      "destination": "/en/ecommerce-website-tunisia.html"
    },
    {
      "source": "/art-de-la-difference",
      "destination": "/art-de-la-difference.html"
    },
    {
      "source": "/en/art-of-difference",
      "destination": "/en/art-of-difference.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/en/blog",
      "destination": "/en/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/en/blog/:slug.html"
    }
  ],
  "redirects": [
    {
      "source": "/culture",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/film",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/directors",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/engineering",
      "destination": "/engineering/",
      "permanent": true
    },
    {
      "source": "/engineering/:path(en|expertise|work|studio|engagements|contact|en/expertise|en/work|en/studio|en/engagements|en/contact)",
      "destination": "/engineering/:path/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/:page(services|contact|art-de-la-difference|creation-site-web-tunis|creation-logo-identite-visuelle|referencement-seo-tunis|creation-site-e-commerce-tunisie).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/en/:page(services|contact|art-of-difference|web-design-tunisia|logo-brand-identity-design|seo-agency-tunisia|ecommerce-website-tunisia).html",
      "destination": "/en/:page",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/en/blog/",
      "destination": "/en/blog",
      "permanent": true
    },
    {
      "source": "/en/blog/index.html",
      "destination": "/en/blog",
      "permanent": true
    },
    {
      "source": "/blog/:slug([a-z0-9-]+).html",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/en/blog/:slug([a-z0-9-]+).html",
      "destination": "/en/blog/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(mp4|jpg|png|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/art-de-la-difference/(.+)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/engineering/(.*)\\.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
